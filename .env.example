# Spokarr configuration.
# Normally you configure everything in the web interface (Settings). These variables are only
# read on the very first start to pre-fill the settings – useful for automated deployments.

# Port of the web interface
PORT=5057

# Audible store used for the catalog: us, uk, ca, au, in, de, fr, it, es, jp
AUDIBLE_REGION=us
# Only show books in this language on the discover page (default: language of the region)
# CONTENT_LANGUAGE=english

# Folder where finished audiobooks are placed (inside the container: mount your library here)
LIBRARY_DIR=/audiobooks

# --- Newznab indexer (optional if you use Prowlarr) --------------------------
NEWZNAB_URL=https://indexer.example/api
NEWZNAB_API_KEY=
# Audiobook categories of your indexer (3030 = Audio/Audiobook in the Newznab standard)
NEWZNAB_CATEGORIES=3030

# --- SABnzbd (optional if you use qBittorrent) -------------------------------
SAB_URL=http://sabnzbd:8080
SAB_API_KEY=
# Category Spokarr uses for its downloads. Create it in SABnzbd with the default folder.
# SABnzbd must write to a folder on the same filesystem as LIBRARY_DIR, so finished
# downloads can be moved instead of copied.
SAB_CATEGORY=spokarr

# --- qBittorrent (optional) ---------------------------------------------------
# QBIT_URL=http://qbittorrent:8080
# QBIT_USERNAME=
# QBIT_PASSWORD=
# QBIT_CATEGORY=spokarr

# --- Prowlarr (optional) ------------------------------------------------------
# Searches all indexers configured in Prowlarr. Some indexers need 3000 (Audio) as well.
# PROWLARR_URL=http://prowlarr:9696
# PROWLARR_API_KEY=
# PROWLARR_CATEGORIES=3030

# --- Audiobookshelf (optional) -----------------------------------------------
# Enables "available" status, automatic library scan and Audible match after import.
ABS_URL=http://audiobookshelf:80
# Address your browser uses to open Audiobookshelf (for the "Listen" button)
ABS_PUBLIC_URL=http://localhost:13378
# Create under Settings → API Keys in Audiobookshelf
ABS_API_KEY=
# Leave empty to use the first book library
ABS_LIBRARY_ID=
# Path of LIBRARY_DIR as Audiobookshelf sees it
ABS_LIBRARY_MOUNT=/audiobooks

# --- Discover page (optional) ------------------------------------------------
# Extra rows: "Title|keywords|narrator" separated by ";"
# Example: DISCOVER_ROWS=Fantasy|fantasy;Read by Stephen Fry|Stephen Fry|Stephen Fry
DISCOVER_ROWS=
